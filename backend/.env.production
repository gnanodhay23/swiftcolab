# SwiftColab Production Environment Configuration
# Copy this file and fill in your production values

# ==============================================
# SERVER CONFIGURATION
# ==============================================
NODE_ENV=production
PORT=4000

# Frontend URL (for CORS)
FRONTEND_URL=https://your-domain.com

# ==============================================
# DATABASE
# ==============================================
# PostgreSQL connection string (Supabase, Neon, Railway, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ==============================================
# AUTHENTICATION
# ==============================================
# JWT Secret - MUST be a long random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secure-jwt-secret-min-64-characters

# JWT Token expiration
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ==============================================
# EXTERNAL APIs
# ==============================================
# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key

# Composio API Key
COMPOSIO_API_KEY=your-composio-api-key

# ==============================================
# TEMPORAL (Optional - for durable workflows)
# ==============================================
TEMPORAL_ADDRESS=127.0.0.1:7233
# For cloud: temporal.your-namespace.tmprl.cloud:7233

# ==============================================
# SECURITY
# ==============================================
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cookie settings
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=.your-domain.com

# ==============================================
# MONITORING (Optional)
# ==============================================
# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ==============================================
# FRAPPE/ERPNEXT (Optional)
# ==============================================
# FRAPPE_URL=https://your-erpnext-instance.com
# FRAPPE_API_KEY=your-api-key
# FRAPPE_API_SECRET=your-api-secret
